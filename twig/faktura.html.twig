<h3>SMS-forbruk i {{ season }}-sesongen</h3>
<p>Listen viser sendte SMS per arrangement, med sum for hver kommune og hvert fylke.</p>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Fylke / kommune / arrangement</th>
			<th>SMS</th>
		</tr>
		<tr class="alert-info">
			<th>TOTAL</th>
			<th>{{ total }}</th>
		</tr>
	</thead>
	<tbody>
		{% for fylke in fylker %}
			<tr class="active">
				<th>{{ fylke.name }}</th>
				<th>{{ fylke.total }}</th>
			</tr>
			{% for arrangement in fylke.arrangementer %}
				<tr>
					<td style="padding-left: 2em;">{{ arrangement.pl_name }}</td>
					<td>{{ arrangement.credits }}</td>
				</tr>
			{% endfor %}
			{% for kommune in fylke.kommuner %}
				<tr>
					<td style="padding-left: 2em;"><strong>{{ kommune.name }}</strong></td>
					<td><strong>{{ kommune.total }}</strong></td>
				</tr>
				{% for arrangement in kommune.arrangementer %}
					<tr>
						<td style="padding-left: 4em;">{{ arrangement.pl_name }}</td>
						<td>{{ arrangement.credits }}</td>
					</tr>
				{% endfor %}
			{% endfor %}
		{% else %}
			<tr>
				<td colspan="2">Ingen SMS-forbruk i denne sesongen.</td>
			</tr>
		{% endfor %}
	</tbody>
</table>
