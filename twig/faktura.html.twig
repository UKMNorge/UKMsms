<h3>SMS-forbruk i {{ season }}-sesongen</h3>
<p>Listen viser sendte SMS per arrangement for kommuner og fylker med mer enn {{ gratisSMS }} SMS. Høyeste forbruk vises først.</p>

{% set totalEkskludertGratis = 0 %}
{% set antallSMS = 0 %}
{% set antallBetalendeSMS = 0 %}
<table class="table table-striped">
	<thead>
		<tr>
			<th>Område / arrangement</th>
			<th>Type</th>
			<th>Antall SMS</th>
			<th>Betalende SMS</th>
			<th>Beløp</th>
		</tr>
	</thead>
	<tbody>
		{% for omraade in omraader %}
			<tr class="active">
				<th>
					<h4>{{ omraade.name }}</h4>
					<button type="button" class="button button-small" aria-expanded="false" onclick="toggleArrangementer('{{ omraade.type_key }}-{{ omraade.id }}', this)">Vis arrangementer</button>
				</th>
				<th>{{ omraade.type }}</th>
				<th><strong>{{ omraade.total }}</strong></th>
				<th class="total-betalende-sms">{{omraade.total - gratisSMS }}</th>
				<th class="total-belop">{{ ((omraade.total - gratisSMS) * SMSprice)|kroner(2) }} kr</th>
				{% set totalEkskludertGratis = totalEkskludertGratis + ((omraade.total - gratisSMS) * SMSprice) %}
				{% set antallSMS = antallSMS + omraade.total %}
				{% set antallBetalendeSMS = antallBetalendeSMS + (omraade.total - gratisSMS) %}
			</tr>
			{% for arrangement in omraade.arrangementer %}
				<tr class="sms-arrangement-{{ omraade.type_key }}-{{ omraade.id }}" hidden>
					<td></td>
					<td style="padding-left: 2em;">{{ arrangement.pl_name }}</td>
					<td>{{ arrangement.credits }}</td>
				</tr>
			{% endfor %}
		{% else %}
			<tr>
				<td colspan="3">Ingen SMS-forbruk over {{ gratisSMS }} i denne sesongen.</td>
			</tr>
		{% endfor %}
		<tr class="alert-info">
			<th>TOTAL</th>
			<th>Alle</th>
			<th>{{ antallSMS }}</th>
			<th>{{ antallBetalendeSMS }}</th>
			<th>{{ totalEkskludertGratis|kroner(2) }} kr </th>
		</tr>
	</tbody>
</table>

<script>
	function toggleArrangementer(group, button) {
		var rows = document.getElementsByClassName('sms-arrangement-' + group);
		var show = button.getAttribute('aria-expanded') !== 'true';

		for (var i = 0; i < rows.length; i++) {
			rows[i].hidden = !show;
		}

		button.setAttribute('aria-expanded', show ? 'true' : 'false');
		button.textContent = show ? 'Skjul arrangementer' : 'Vis arrangementer';
	}
</script>
