<h3>SMS-forbruk i {{ season }}-sesongen</h3>
<p>Listen viser sendte SMS per arrangement for kommuner og fylker med mer enn {{ minimumForbruk }} SMS. Høyeste forbruk vises først.</p>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Fylke / kommune / arrangement</th>
			<th>SMS</th>
		</tr>
		<tr class="alert-info">
			<th>TOTAL</th>
			<th>{{ total }}</th>
		</tr>
	</thead>
	<tbody>
		{% for fylke in fylker %}
			<tr class="active">
				<th>
					{{ fylke.name }}
					{% if fylke.arrangementer|length > 0 %}
						<button type="button" class="button button-small" aria-expanded="false" onclick="toggleArrangementer('fylke-{{ fylke.id }}', this)">Vis arrangementer</button>
					{% endif %}
				</th>
				<th>{{ fylke.total }}</th>
			</tr>
			{% for arrangement in fylke.arrangementer %}
				<tr class="sms-arrangement-fylke-{{ fylke.id }}" hidden>
					<td style="padding-left: 2em;">{{ arrangement.pl_name }}</td>
					<td>{{ arrangement.credits }}</td>
				</tr>
			{% endfor %}
			{% for kommune in fylke.kommuner %}
				<tr>
					<td style="padding-left: 2em;">
						<strong>{{ kommune.name }}</strong>
						<button type="button" class="button button-small" aria-expanded="false" onclick="toggleArrangementer('kommune-{{ kommune.id }}', this)">Vis arrangementer</button>
					</td>
					<td><strong>{{ kommune.total }}</strong></td>
				</tr>
				{% for arrangement in kommune.arrangementer %}
					<tr class="sms-arrangement-kommune-{{ kommune.id }}" hidden>
						<td style="padding-left: 4em;">{{ arrangement.pl_name }}</td>
						<td>{{ arrangement.credits }}</td>
					</tr>
				{% endfor %}
			{% endfor %}
		{% else %}
			<tr>
				<td colspan="2">Ingen SMS-forbruk i denne sesongen.</td>
			</tr>
		{% endfor %}
	</tbody>
</table>

<script>
	function toggleArrangementer(group, button) {
		var rows = document.getElementsByClassName('sms-arrangement-' + group);
		var show = button.getAttribute('aria-expanded') !== 'true';

		for (var i = 0; i < rows.length; i++) {
			rows[i].hidden = !show;
		}

		button.setAttribute('aria-expanded', show ? 'true' : 'false');
		button.textContent = show ? 'Skjul arrangementer' : 'Vis arrangementer';
	}
</script>
